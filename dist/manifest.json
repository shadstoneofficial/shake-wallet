{
    "manifest_version": 3,
    "name": "LearnHNS Wallet",
    "description": "A browser wallet for Handshake names, HNS, DNS records, and dapp confirmations.",
    "version": "0.2.1",
    "action": {
        "default_icon": "icon-16.png",
        "default_title": "LearnHNS Wallet",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "js/backgroundPage.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://market.learnhns.com/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "js/content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "permissions": [
        "unlimitedStorage",
        "alarms"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "js/shake.js"
            ],
            "matches": [
                "https://market.learnhns.com/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ]
        }
    ]
}
